# Copy to .env. Without these the server still runs and answers from built-in guidance.
# Server-only: never put this key in extension code.
OPENAI_API_KEY=
# Any current OpenAI model that supports structured (json_schema) outputs.
COPILOT_MODEL=
PORT=3000
# Only set to true if you deliberately expose the server beyond this machine.
COPILOT_ALLOW_REMOTE=false
